+  }
+  __threadfence();
+  named_bar(1, NT);
+  if (tid == 0) {
+    int old = atomicAdd(counters + rb, 1);
+    int target = (old / splits + 1) * splits;
+    while (true) {
+      int v = *((volatile int*)(counters + rb));
+      if (v - target >= 0) break;
