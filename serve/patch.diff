+      for (int q = 0; q < splits; q += 4) {
+        float4 v[2][4];
+#pragma unroll
+        for (int u = 0; u < 2; ++u)
+#pragma unroll
+          for (int qq = 0; qq < 4; ++qq) {
+            v[u][qq] = make_float4(0.f, 0.f, 0.f, 0.f);
