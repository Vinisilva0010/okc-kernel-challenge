+def sk2_tileunits(w):
+    """W [N, K] -> [N/8, K/64, 32 lanes, 16] in mma.m16n8k16 B-fragment order: lane (g, t) holds row g and, for each
+    k-step j of the 64-k unit, k = 16j + 2t, 2t+1, 2t+8, 2t+9."""
+    n, k = w.shape
+    t = w.view(n // 8, 8, k // 64, 4, 2, 4, 2)          # [tile, g, unit, j, h, t, p]: k = 64u + 16j + 8h + 2t + p
+    return t.permute(0, 2, 1, 5, 3, 4, 6).reshape(n // 8, k // 64, 32, 16)
+
+
+def sk2_compress(w):
+    """Lossless 12-bit packing of BF16 W [N, K] into B-fragment tile-units [N/8, K/64, 768] (512 B low bytes, lane-major,
+    then 256 B of 4-bit codes) + escapes (row, k, delta) that the kernel corrects exactly.  Returns None if unsuitable."""
+    n, k = w.shape
+    tu = sk2_tileunits(w)
+    bits = tu.contiguous().view(torch.int16).to(torch.int32) & 0xFFFF
+    hi = bits >> 8
+    low = bits & 0xFF
+    e71 = hi & 0x7F
+    sign = hi >> 7
+    base, o = _exponent_window(e71)
+    code = (sign << 3) | o
+    esc = _escapes(e71, base)
+    if int(esc.sum()) > n * k // MAX_ESCAPE_DENOMINATOR:
+        return None
+    T, U = n // 8, k // 64
+    c8 = code.to(torch.uint8)
+    w0 = c8[..., 0:4] | (c8[..., 4:8] << 4)
+    w1 = c8[..., 8:12] | (c8[..., 12:16] << 4)
+    codes = torch.cat([w0, w1], dim=-1)                  # [T, U, 32, 8]
+    packed = torch.cat([low.to(torch.uint8).reshape(T, U, 512), codes.reshape(T, U, 256)], dim=-1).contiguous()
+    idx = esc.nonzero()                                   # [E, 4]: tile, unit, lane, v
+    dec_bits = ((((sign << 7) | (base + o)) << 8) | low)[esc]
+    wdec = dec_bits.to(torch.int16).view(torch.bfloat16).float()
+    wtrue = tu[esc].float()
+    delta = wtrue - wdec
+    if not bool(((wdec + delta) == wtrue).all()):
+        return None
+    lane, v = idx[:, 2], idx[:, 3]
+    rows = idx[:, 0] * 8 + (lane >> 2)
+    cols = idx[:, 1] * 64 + 16 * (v >> 2) + 8 * ((v >> 1) & 1) + 2 * (lane & 3) + (v & 1)
+    wbits = (tu[esc].contiguous().view(torch.int16).to(torch.int32) & 0xFFFF).contiguous()   # the original BF16 weights
+    return {"packed": packed, "base4": base * BASE4_REPLICATE, "rows": rows, "cols": cols, "wbits": wbits}
+
+
+CG_CONFIGS = {"qkv_gate": (2, 256), "o": (2, 64), "unpooler": (2, 128), "pooler": (2, 512)}   # layer -> (rows per CTA, threads); m = 1
+# (v137: pooler m=1 cgemv 2x512 measured -0.34 us vs sk2; 2x256 ties sk2, 4/8 rows or 1 row lose)
+
+
+def cg_compress(w, rows_per_cta):
+    """Row-major 12-bit planes for cgemv (lossless; escapes corrected exactly from a per-CTA table)."""
+    n, k = w.shape
+    bits = w.contiguous().view(torch.int16).to(torch.int32) & 0xFFFF
+    hi, low = bits >> 8, bits & 0xFF
+    e71, sign = hi & 0x7F, hi >> 7
+    base, o = _exponent_window(e71)
+    code = ((sign << 3) | o).to(torch.uint8)
+    esc = _escapes(e71, base)
+    if int(esc.sum()) > n * k // MAX_ESCAPE_DENOMINATOR:
+        return None
+    g = code.view(n, k // 8, 8)
+    C = (g[:, :, 0:4] | (g[:, :, 4:8] << 4)).reshape(n, k // 2).contiguous()
+    L = low.to(torch.uint8).contiguous()
+    rows, cols = esc.nonzero(as_tuple=True)          # row-major order
+    dec = ((((sign[rows, cols] << 7) | (base + o[rows, cols])) << 8) | low[rows, cols]).to(torch.int16).view(torch.bfloat16).float()
+    wtrue = w[rows, cols].float()
+    delta = (wtrue - dec).contiguous()
+    if not bool(((dec + delta) == wtrue).all()):
+        return None
+    ncta = n // rows_per_cta
+    cta = rows // rows_per_cta
+    counts = torch.bincount(cta, minlength=ncta)
+    pmax = int(counts.max()) + 1 if rows.numel() else 1
+    start = torch.cumsum(counts, 0) - counts
+    pos = torch.arange(rows.numel(), device=w.device) - start[cta] + 1
+    tab = torch.zeros(ncta, pmax, 2, dtype=torch.int32, device=w.device)
+    tab[:, 0, 0] = counts.to(torch.int32)
+    tab[cta, pos, 0] = (((rows - cta * rows_per_cta) << 16) | cols).to(torch.int32)
+    tab[cta, pos, 1] = bits[rows, cols].to(torch.int32)   # the original BF16 weights; the kernel forms the correction
+    return {"L": L, "C": C, "tab": tab.contiguous(), "pmax": pmax, "base4": base * BASE4_REPLICATE}
+
+
+def sk2_stream(tub, n_cfg, R, NT, NWR, WSK, UPW):
+    """Stage-major stream [stage][cta][warp][unit][tile][bytes] for the first n_cfg rows."""
+    dev = tub.device
+    U = tub.shape[1]
+    ups = WSK * UPW
+    ar = lambda v: torch.arange(v, device=dev)
+    s = ar(U // ups).view(-1, 1, 1, 1, 1)
+    c = ar(n_cfg // R).view(1, -1, 1, 1, 1)
+    w = ar(NWR * WSK).view(1, 1, -1, 1, 1)
+    uu = ar(UPW).view(1, 1, 1, -1, 1)
+    nt = ar(NT).view(1, 1, 1, 1, -1)
+    tile = c * (R // 8) + (w // WSK) * NT + nt
+    unit = s * ups + (w % WSK) * UPW + uu
+    return tub[tile, unit].contiguous()
+
+
+SK2_BALANCE = True   # v135: deal 4-row groups to sk2 row blocks so every block carries ~the same number of escapes
+SK2_BALANCE_LAYERS = {"qkv_gate"}   # v136: only where it measured a gain (qkv m=8/16 -0.5 us; o/unpooler m=32 lost)
+
+
+def sk2_balance_perm(w, n_rows, R):
+    """Row order for R-row sk2 blocks over the first n_rows rows of w: rows sorted by escape count and snake-dealt, so
+    every block holds ~the same number of escapes (the escape warps' work sets the CTA tail). perm[p] = original row."""
+    wl = w[:n_rows]
+    bits = wl.contiguous().view(torch.int16).to(torch.int32) & 0xFFFF
+    e71 = (bits >> 8) & 0x7F
+    base, _ = _exponent_window(e71)
+    cnt = _escapes(e71, base).sum(1)
+    # 4-row groups are dealt (keeps 4-column output groups contiguous: vector stores in the epilogue)
+    G4 = 4
+    tcnt = cnt.view(n_rows // G4, G4).sum(1)
+    order = torch.argsort(tcnt, descending=True, stable=True)
+    TB = R // G4                                   # groups per block
+    nb = n_rows // R
+    i = torch.arange(n_rows // G4, device=w.device)
+    rnd, pos = i // nb, i % nb
+    blk = torch.where(rnd % 2 == 0, pos, nb - 1 - pos)
+    tperm = torch.empty(n_rows // G4, dtype=torch.long, device=w.device)
+    tperm[blk * TB + rnd] = order
+    return (tperm.view(-1, 1) * G4 + torch.arange(G4, device=w.device).view(1, G4)).reshape(-1)
+
+
+def sk2_table_add_perm(tab, pmax, perm, R):
+    """Append each CTA's row map (R int32 output columns) after its escapes; entry 0 .y = the map's int2 offset."""
+    ncta = tab.shape[0]
+    pm2 = pmax + R // 2
+    pm2 += pm2 % 2
+    out = torch.zeros(ncta, pm2, 2, dtype=torch.int32, device=tab.device)
+    out[:, :pmax] = tab
+    out[:, pmax:pmax + R // 2] = perm.to(torch.int32).view(ncta, R // 2, 2)
+    out[:, 0, 1] = pmax
+    return out.contiguous(), pm2
+
+
+def sk2_table(comp, n_cfg, R):
+    """Per-CTA escape table int2 [ncta][pmax]: entry 0 = (count, 0); entries ((row_local << 16) | k, the escaped weight's
+    original BF16 bits); the kernel forms the exact correction (w - decode(w)) itself."""
+    dev = comp["rows"].device
+    rows, cols, delta = comp["rows"], comp["cols"], comp["wbits"]
+    keep = rows < n_cfg
+    rows, cols, delta = rows[keep], cols[keep], delta[keep]
+    ncta = n_cfg // R
+    cta = rows // R
+    counts = torch.bincount(cta, minlength=ncta)
+    pmax = int(counts.max().item()) + 1 if rows.numel() else 1
+    pmax += pmax % 2
+    order = torch.argsort(cta.long() * 65536 + cols.long())   # per CTA in k order (the kernel walks K once)
+    cta, rows, cols, delta = cta[order], rows[order], cols[order], delta[order]
+    start = torch.zeros(ncta + 1, dtype=torch.long, device=dev)
+    start[1:] = torch.cumsum(counts, 0)
+    slot = torch.arange(cta.numel(), device=dev) - start[cta] + 1
+    tab = torch.zeros(ncta, pmax, 2, dtype=torch.int32, device=dev)
+    tab[:, 0, 0] = counts.to(torch.int32)
+    tab[cta, slot, 0] = (((rows % R) << 16) | cols).to(torch.int32)
+    tab[cta, slot, 1] = delta.to(torch.int32)
+    return tab.contiguous(), pmax
+
+
+def sk2_prepare(weights, state):
+    state["sk2"] = {}
+    dev = weights["o"].device
+    shared = {}
+    for ci, cfg in enumerate(SK2_CONFIGS):
+        name, layer, n_rows, R, NT, NWR, WSK, UPW, NACC, CL = cfg
+        w = weights[layer]
+        if layer == "router":
+            hi = w.to(torch.bfloat16)
+            lo = (w - hi.float()).to(torch.bfloat16)
+            T, U = w.shape[0] // 8, w.shape[1] // 64
+            tub = torch.cat([sk2_tileunits(hi).contiguous().view(torch.uint8).reshape(T, U, 1024),
+                             sk2_tileunits(lo).contiguous().view(torch.uint8).reshape(T, U, 1024)], dim=-1)
+            stream = sk2_stream(tub, n_rows, R, NT, NWR, WSK, UPW)
+            tab, pmax, b4 = state["dummy"], 0, 0
+        else:
+            perm = None
+            if SK2_BALANCE and CL == 1 and layer in SK2_BALANCE_LAYERS:
+                pkey = (layer, n_rows, R)
+                bal = state.setdefault("sk2_bal", {})
+                if pkey not in bal:
+                    pr = sk2_balance_perm(w, n_rows, R)
+                    bal[pkey] = (pr, sk2_compress(w[:n_rows][pr].contiguous()))
+                perm, comp = bal[pkey]
+                if comp is None:
+                    perm = None
+            if perm is None:
+                comp = state.setdefault("sk2_comp", {}).get(layer)
+                if comp is None:
+                    comp = sk2_compress(w.contiguous())
+                    state["sk2_comp"][layer] = comp
+            if comp is None:
+                continue
+            lkey = (layer, n_rows, R, NT, NWR, WSK, UPW, perm is not None)   # configs differing only in NACC / ring depth share a stream
+            if lkey not in shared:
+                tab, pmax = sk2_table(comp, n_rows, R)
+                if perm is not None:
+                    tab, pmax = sk2_table_add_perm(tab, pmax, perm, R)
+                shared[lkey] = (sk2_stream(comp["packed"], n_rows, R, NT, NWR, WSK, UPW), tab, pmax)
+            stream, tab, pmax = shared[lkey]
+            b4 = comp["base4"]
+        state["sk2"][name] = (ci, stream, tab, pmax, b4, n_rows)
+    state.pop("sk2_comp", None)
+    state.pop("sk2_bal", None)
+
+
+def _run_sk2(x, layer, m, n, k, state, dg=0, dbg=None):
+    name = _sk2_name(layer, m)
+    ci, stream, tab, pmax, b4, n_rows = state["sk2"][name]
+    out = torch.empty((m, n), dtype=torch.float32 if layer == "router" else torch.bfloat16, device=x.device)
+    _get_ext().sk2(stream, x, out, tab, pmax, b4, m, n, k, ci, _sk2_tokr(m), dg, state["dummy"] if dbg is None else dbg)
+    return out
+
+
+
+
+# ===========================================================================================================
+# proj_mk: fixed-table serving API (code below is new; everything above is vjeux/okc-2026 sub_pub1 kernel code)
+#
+# One ``ProjHandle`` per projection weight (qkv_gate, o, pooler, unpooler, router). Differences from the
+# public ``prepare()/kernel_fn()`` pair:
+#   * the route per (layer, token bucket) is the FIXED table ROUTES_* below, read off the judge's autotune log of
+#     the 1.499x board run (job 65a6e80c32b04437), not timed at load: every process and every run takes the same
+#     route, so outputs are deterministic for a given shape;
+#   * only the layouts the table needs are built; the compressed weights are verified to decode back to the
+#     original BF16 bits (``sk2_roundtrip_ok``) before any kernel may read them;
+#   * the caller keeps its own BF16 weight: ``run()`` returns None for every shape not in the table (prefill,
+#     M > 256, buckets where cuBLAS won or tied) and the caller then runs its stock path;
+#   * nothing is compiled, allocated or synchronised in ``run()`` apart from the fresh output tensor.
+# ===========================================================================================================
+SELFTEST_ROWS = (1, 3, 8, 9, 16, 24, 32, 33, 64, 100, 128, 129, 200, 256)
+SK2_PICK_LEAN = dict(SK2_PICK)   # one stream per weight: o / pooler / unpooler use their m = 32 layout for every token bucket
+for _tr in (8, 16, 32):
+    SK2_PICK_LEAN[("o", _tr)] = SK2_PICK[("o", 32)]
+    SK2_PICK_LEAN[("pooler", _tr)] = SK2_PICK[("pooler", 32)]
+SK2_PICK_LEAN[("unpooler", 16)] = SK2_PICK[("unpooler", 32)]
+SK2_PICK_LEAN[("unpooler", 32)] = SK2_PICK[("unpooler", 32)]
+
+# route per (layer, bucket); a missing bucket means "stock path" (None). Bucket = _tm(m).
+ROUTES_SERVING = {
+    "qkv_gate": {8: "sk2", 16: "sk2", 32: "sk2", 128: "gqx"},
+    "o": {8: "sk2", 16: "sk2", 32: "sk2"},
+    "pooler": {8: "sk2", 16: "sk2", 32: "sk2", 128: "gq"},
+    "unpooler": {16: "sk2", 32: "sk2"},   # m <= 8 is the 1024-row slice in phase 1; serving runs the full weight there
+    "router": {16: "sk2", 32: "sk2", 128: "rk", 256: "rk"},   # m <= 8 stays stock (fp32 F.linear)
+}
+# phase-1 shapes (check file only): adds m = 1 GEMVs and the unpooler's 1024-row slice at m <= 8
+ROUTES_PHASE1 = {
+    "qkv_gate": {1: "cgemv", 8: "sk2", 16: "sk2", 32: "sk2", 128: "gqx"},
+    "o": {1: "cgemv", 8: "sk2", 16: "sk2", 32: "sk2"},
+    "pooler": {1: "cgemv", 8: "sk2", 16: "sk2", 32: "sk2", 128: "gq"},
+    "unpooler": {1: "cgemv", 8: "sk2", 16: "sk2", 32: "sk2"},
+    "router": {1: "rgemv", 8: "sk2", 16: "sk2", 32: "sk2", 128: "rk", 256: "rk"},
+}
+PROJ_SHAPES = {"qkv_gate": (2304, 8192), "o": (8192, 1024), "pooler": (4096, 8192), "unpooler": (8192, 4096), "router": (256, 8192)}
+PROJ_MAX_M = 256
+# Weights the serving plan binds. The unpooler is left out: stock keeps m <= 8 (fused all-gather GEMM) and m >= 33, it gains 3.5-4.7 us only at
+# m 9..32 and costs 48 MB per layer (~3 GB per GPU). Add "unpooler" here to bind it (the table has its m = 16 / 32 buckets).
+SERVING_WEIGHTS = ("qkv_gate", "o", "pooler", "router")
+
+_shared = {}
+
+
+def _tm(m, phase1):
+    if m < 1 or m > PROJ_MAX_M:
+        return None
+    if m == 1 and phase1:
+        return 1
+    return 8 if m <= 8 else 16 if m <= 16 else 32 if m <= 32 else 128 if m <= 128 else 256
+
+
+def sk2_decompress(comp, n, k):
+    """Inverse of sk2_compress: BF16 bits (int16 [n, k]) rebuilt from the packed bytes plus the escape list."""
+    T, U = n // 8, k // 64
+    p = comp["packed"].view(T, U, 768)
+    low = p[..., :512].to(torch.int32).reshape(T, U, 32, 16)
+    codes = p[..., 512:].reshape(T, U, 32, 8).to(torch.int32)
+    w0, w1 = codes[..., 0:4], codes[..., 4:8]
+    c8 = torch.cat([w0 & 15, w0 >> 4, w1 & 15, w1 >> 4], dim=-1)
+    base = int(comp["base4"]) & 0xFF
+    hi = (((c8 >> 3) << 7) | (base + (c8 & 7)))
+    bits = (hi << 8) | low
+    bits = ((bits + 32768) & 0xFFFF) - 32768
+    tu = bits.to(torch.int16).view(T, U, 8, 4, 4, 2, 2)   # [tile, unit, g, t, j, h, p]
+    wb = tu.permute(0, 2, 1, 4, 5, 3, 6).reshape(n, k).contiguous()
+    rows, cols = comp["rows"], comp["cols"]
+    if rows.numel():
+        eb = ((comp["wbits"] + 32768) & 0xFFFF) - 32768
+        wb[rows, cols] = eb.to(torch.int16)
+    return wb
+
+
+def sk2_roundtrip_ok(w, comp):
+    """True iff decoding the packed weights reproduces every BF16 bit of w."""
+    n, k = w.shape
+    return bool(torch.equal(sk2_decompress(comp, n, k), w.contiguous().view(torch.int16)))
+
+
+def _shared_for(dev):
+    key = (dev.type, dev.index)
+    if key not in _shared:
+        _shared[key] = {"dummy": torch.zeros(2, dtype=torch.int32, device=dev),
+                        "nsm": torch.cuda.get_device_properties(dev).multi_processor_count}
+    return _shared[key]
+
+
+def _sk2_prepare_layer(name, w, state, picks):
+    """Build the sk2 streams for the configs in ``picks`` (names of SK2_CONFIGS entries) of one weight; verifies the
+    compression round trip. Raises RuntimeError when the weight cannot be packed or the round trip fails."""
+    state["sk2"] = {}
+    shared, bal = {}, {}
+    comp_full = None
+    for ci, cfg in enumerate(SK2_CONFIGS):
+        cname, layer, n_rows, R, NT, NWR, WSK, UPW, NACC, CL = cfg
+        if layer != name or cname not in picks:
+            continue
+        if layer == "router":
+            hi = w.to(torch.bfloat16)
+            lo = (w - hi.float()).to(torch.bfloat16)
+            T, U = w.shape[0] // 8, w.shape[1] // 64
+            tub = torch.cat([sk2_tileunits(hi).contiguous().view(torch.uint8).reshape(T, U, 1024),
+                             sk2_tileunits(lo).contiguous().view(torch.uint8).reshape(T, U, 1024)], dim=-1)
+            stream = sk2_stream(tub, n_rows, R, NT, NWR, WSK, UPW)
+            state["sk2"][cname] = (ci, stream, state["dummy"], 0, 0, n_rows)
+            continue
+        perm = None
+        if SK2_BALANCE and CL == 1 and layer in SK2_BALANCE_LAYERS:
+            pkey = (n_rows, R)
+            if pkey not in bal:
+                pr = sk2_balance_perm(w, n_rows, R)
+                wp = w[:n_rows][pr].contiguous()
+                c = sk2_compress(wp)
+                if c is None or not sk2_roundtrip_ok(wp, c):
+                    raise RuntimeError(f"{name}: balanced packing failed or does not round-trip")
+                bal[pkey] = (pr, c)
+            perm, comp = bal[pkey]
+        else:
+            if comp_full is None:
+                comp_full = sk2_compress(w.contiguous())
+                if comp_full is None or not sk2_roundtrip_ok(w, comp_full):
+                    raise RuntimeError(f"{name}: packing failed or does not round-trip")
+            comp = comp_full
+        lkey = (n_rows, R, NT, NWR, WSK, UPW, perm is not None)
+        if lkey not in shared:
+            tab, pmax = sk2_table(comp, n_rows, R)
+            if perm is not None:
+                tab, pmax = sk2_table_add_perm(tab, pmax, perm, R)
+            shared[lkey] = (sk2_stream(comp["packed"], n_rows, R, NT, NWR, WSK, UPW), tab, pmax)
+        stream, tab, pmax = shared[lkey]
+        state["sk2"][cname] = (ci, stream, tab, pmax, comp["base4"], n_rows)
+    state["roundtrip"] = True
+
+
+class ProjHandle:
+    """One projection weight bound to the fixed route table. ``run(x)`` returns the output or None (stock path)."""
+
+    def __init__(self, name, weight, phase1=False, lean=True, router_big="gemm"):
+        self.name, self.phase1 = name, phase1
+        self.pick = SK2_PICK_LEAN if lean else SK2_PICK
+        self.weight = weight   # the caller's own tensor (never copied, never modified)
+        self.routes = dict((ROUTES_PHASE1 if phase1 else ROUTES_SERVING)[name])
+        if name == "router":   # m 33..256: 'rk' (fast, not bitwise reproducible), 'gemm' (wgmma split-K) or None (stock)
+            for tb in (128, 256):
+                if router_big is None:
+                    self.routes.pop(tb, None)
+                else:
+                    self.routes[tb] = router_big
+        self.n, self.k = weight.shape
+        self.disabled = set()
+        self.extra_bytes = 0
+        self.roundtrip = None
+        dev = weight.device
+        sh = _shared_for(dev)
+        self.state = state = {"raw": {name: weight}, "dummy": sh["dummy"], "nsm": sh["nsm"], "sm90": True, "sk2": {}, "cg": {}}
+        before = torch.cuda.memory_allocated(dev)
+        _get_ext()
+        used = set(self.routes.values())
+        if "sk2" in used:
+            picks = {self.pick[(name, tr)] for tr in (8, 16, 32) if self.routes.get(tr) == "sk2"}
+            _sk2_prepare_layer(name, weight, state, picks)
+            self.roundtrip = True
+        if "cgemv" in used:
+            wc = weight[:UNPOOLER_SLICE_ROWS] if name == "unpooler" else weight
+            cg = cg_compress(wc.contiguous(), CG_CONFIGS[name][0])
+            if cg is None:
+                self.routes.pop(1)
+            else:
+                state["cg"][name] = cg
+        if "gemm" in used:
+            floats = 0
+            for (ln, bn), (nwg, splits, _st) in GEMM_CONFIGS.items():
+                if ln == "router":
+                    floats = max(floats, (self.n // (64 * nwg)) * splits * (nwg * 128) * (bn // 2))
+            state["mid_ws"] = torch.empty(floats, dtype=torch.float32, device=dev)
+            state["mid_cnt"] = torch.zeros(self.n // 16, dtype=torch.int32, device=dev)
+        if "rk" in used or "gemm" in used:
+            hi = weight.to(torch.bfloat16)
+            lo = (weight - hi.float()).to(torch.bfloat16)
+            state["router_cat"] = torch.cat([hi, lo], dim=1).contiguous()
+            del hi, lo
+            state["rk_zc"] = torch.zeros(8, dtype=torch.int32, device=dev)
+        torch.cuda.synchronize(dev)
+        self.extra_bytes = torch.cuda.memory_allocated(dev) - before
+        self.enabled = True
+        self._selftest()
+
+    def route(self, m, n=None):
+        tm = _tm(m, self.phase1)
+        if tm is None:
+            return None
+        r = self.routes.get(tm)
+        if r is None or tm in self.disabled:
+            return None
+        if tm == 256 and m != 256 and self.name != "router":
+            return None   # untuned m in 129..255: stock call (the m = 256 picks lose to cuBLAS at partial tiles)
+        if self.name == "unpooler" and self.phase1 and tm in (1, 8) and n != UNPOOLER_SLICE_ROWS:
+            return None
+        if r == "gq" and (self.name, _gq_bn(m)) not in GQ_CONFIGS:
+            return None
+        if r == "gqx" and (self.name, _gqx_bn(m)) not in GQX_CONFIGS:
+            return None
+        if r == "sk2" and self.pick[(self.name, _sk2_tokr(m))] not in self.state["sk2"]:
+            return None
+        return r
+
+    def _run(self, r, x, n):
+        st, name, m = self.state, self.name, x.shape[0]
+        if r == "sk2":
+            ci, stream, tab, pmax, b4, _nr = st["sk2"][self.pick[(name, _sk2_tokr(m))]]
+            out = torch.empty((m, n), dtype=torch.float32 if name == "router" else torch.bfloat16, device=x.device)
+            _get_ext().sk2(stream, x, out, tab, pmax, b4, m, n, self.k, ci, _sk2_tokr(m), 0, st["dummy"])
+            return out
+        if r == "gemm":
+            bn = 64 if m <= 64 else 128 if m <= 128 else 256
+            nwg, splits, _st = GEMM_CONFIGS[(name, bn)]
+            out = torch.empty((m, n), dtype=torch.float32, device=x.device)
+            _get_ext().gemm90(st["router_cat"], st["dummy"], x, out, st["mid_ws"], st["mid_cnt"], m, n, st["router_cat"].shape[1], self.k,
+                              splits, nwg, bn, 0)
+            return out
+        if r == "gq":
+            return _run_gq(x, name, m, n, self.k, st)
+        if r == "gqx":
+            return _run_gqx(x, name, m, n, self.k, st)
+        if r == "cgemv":
+            cg = st["cg"][name]
+            rows, nth = CG_CONFIGS[name]
+            out = torch.empty((m, n), dtype=torch.bfloat16, device=x.device)
+            _get_ext().cgemv(cg["L"], cg["C"], x, cg["tab"], cg["pmax"], out, cg["base4"], rows, nth)
+            return out
+        if r == "rgemv":
+            out = torch.empty((m, n), dtype=torch.float32, device=x.device)
+            _get_ext().rgemv(self.weight, x, out, m)
+            return out
+        if r == "rk":
+            out = torch.empty((m, n), dtype=torch.float32, device=x.device)
+            _get_ext().rk(st["router_cat"], x, out, _rk_splits(m, st["nsm"]), st["rk_zc"])
+            return out
+        return None
+
+    def run(self, x, n=None):
+        """x: bf16 [m, k], contiguous. Returns [m, n] (bf16; fp32 for the router) or None for the stock path."""
+        if torch.compiler.is_compiling() or not self.enabled or x.dim() != 2 or x.dtype != torch.bfloat16 or x.shape[1] != self.k:
+            return None
+        if not x.is_contiguous() or x.data_ptr() % 16 or x.device != self.weight.device:
+            return None
+        n = self.n if n is None else n
+        r = self.route(x.shape[0], n)
+        if r is None:
+            return None
+        return self._run(r, x, n)
+
+    def _selftest(self):
+        """Run every routed bucket once against an FP64 reference; a route that disagrees is disabled (stock path)."""
+        dev = self.weight.device
+        g = torch.Generator(device=dev)
+        g.manual_seed(SELFTEST_SEED)
+        ms = [m for m in SELFTEST_ROWS if self.route(m, UNPOOLER_SLICE_ROWS if (self.name == "unpooler" and m <= 8) else None)]
+        if not ms:
+            return
+        nn_ = UNPOOLER_SLICE_ROWS if (self.name == "unpooler" and self.phase1) else self.n
+        xs = torch.randn(max(ms), self.k, device=dev, generator=g).to(torch.bfloat16)
+        refs = {}
+        wd = self.weight.double()
+        for m in ms:
+            nn = nn_ if m <= 8 else self.n
+            ref = xs[:m].double() @ wd[:nn].T
+            refs[m] = ref if self.name == "router" else ref.to(torch.bfloat16).double()
+        del wd
+        tol = 2e-5 if self.name == "router" else 5e-3
+        for m in ms:
+            nn = nn_ if m <= 8 else self.n
+            x = xs[:m].contiguous()
+            tm = _tm(m, self.phase1)
+            try:
+                out = self._run(self.route(m, nn), x, nn).double()
+                torch.cuda.synchronize(dev)
+                err = float((out - refs[m]).norm() / refs[m].norm())
+            except RuntimeError as e:   # launch failure: fall back to the stock path
+                err = float("inf")
+                print(f"[proj_mk] selftest {self.name} m={m}: {str(e)[:120]}", file=sys.stderr)
+            if not err < tol:
+                self.disabled.add(tm)
+                print(f"[proj_mk] selftest {self.name} m={m}: rel err {err:.3e} -> bucket {tm} off (stock path)", file=sys.stderr)
+
+
+def bind_projection(name, weight, phase1=False, lean=True, router_big="gemm"):
+    """Build the handle for one projection weight, or return None (stock path stays) when the weight is not exactly
+    the expected shape/dtype, the GPU is not sm_90, or anything fails (the exception is logged, never raised)."""
+    try:
+        shape = PROJ_SHAPES.get(name)
+        if not phase1 and name not in SERVING_WEIGHTS:
+            return None
+        want = torch.float32 if name == "router" else torch.bfloat16
+        if (shape is None or tuple(weight.shape) != shape or weight.dtype != want or not weight.is_cuda
+                or not weight.is_contiguous() or torch.cuda.get_device_capability(weight.device)[0] != 9):
+            return None
+        return ProjHandle(name, weight, phase1, lean, router_big)
+    except Exception as ex:   # noqa: BLE001  (no nvcc / build error / packing refused: the stock path serves everything)
+        print(f"[proj_mk] {name}: not bound ({type(ex).__name__}: {str(ex)[:600]})", file=sys.stderr)
+        return None
+
+
+RK_SPLITS = {1: 16, 2: 12, 3: 10, 4: 8}   # token tiles of 64 -> K splits (grid 4 x ntt x S <= 128)
+
+
+def _rk_splits(m, nsm=132):
+    """K splits for m tokens: the measured table, capped so the grid (4 x ntt x S, one CTA per SM, all resident) fits the GPU."""
+    ntt = (m + 63) // 64
+    return max(1, min(RK_SPLITS[ntt], nsm // (4 * ntt)))
+
+
+def _mt_key(m):   # needed by _tma_srcs (the extension still compiles every kernel family of the public file)
+    return 0 if m == 1 else 1 if m <= 8 else 2 if m <= 16 else 4 if m <= 32 else 8
